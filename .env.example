# Copy to .env and fill in. Nothing here is required to run locally —
# without the Google values the sign-in falls back to an obvious dev stub.

# Where this instance is reachable. Must match the Google redirect URI exactly.
BASE_URL=http://localhost:8787

# Signs the session cookies. Any long random string; changing it signs everyone out.
SESSION_SECRET=change-me-to-something-long-and-random

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SQLite file. Use an absolute path on a real disk in production. "memory" disables persistence.
SCAN_DB=./data/scan.db

# Where `atlan-scan --publish` sends findings by default.
ATLAN_SCAN_SERVER=http://localhost:8787

# --- Semantic review (optional) -------------------------------------------
# With no key the scan runs the 50 deterministic checks and the report says the
# review did not run. With a key, each skill is also read by a model and its
# findings appear in their own block — every quote verified against the file.
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-4-5. Cheap and fast is the right trade here.
SCAN_REVIEW_MODEL=
